"""
config.py
=========
يحمّل إعدادات التطبيق من config.json مع دمج المتغيرات البيئية (Environment Variables / GitHub Secrets).
"""

import json
import os

CONFIG_FILE = "config.json"


def load_config():
    config = {}

    # 1. قراءة الملف الأساسي إذا كان موجوداً
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r", encoding="utf-8") as f:
                config = json.load(f)
        except Exception as e:
            print(f"⚠️ تعذر قراءة {CONFIG_FILE}: {e}")

    # التأكد من وجود الهياكل الرئيسية في القاموس
    if "wordpress" not in config:
        config["wordpress"] = {}
    if "openai" not in config:
        config["openai"] = {}
    if "telegram" not in config:
        config["telegram"] = {}

    # 2. استبدال القيم/الأسرار من المتغيرات البيئية (GitHub Secrets) إن وجدت

    # WordPress Settings
    wp_site_url = os.getenv("WP_SITE_URL")
    if wp_site_url:
        config["wordpress"]["site_url"] = wp_site_url.rstrip("/")

    wp_username = os.getenv("WP_USERNAME")
    if wp_username:
        config["wordpress"]["username"] = wp_username

    wp_app_password = os.getenv("WP_APP_PASSWORD")
    if wp_app_password:
        config["wordpress"]["app_password"] = wp_app_password

    # OpenAI Settings
    openai_key = os.getenv("OPENAI_API_KEY")
    if openai_key:
        config["openai"]["api_key"] = openai_key

    # Telegram Settings
    telegram_token = os.getenv("TELEGRAM_BOT_TOKEN")
    if telegram_token:
        config["telegram"]["bot_token"] = telegram_token

    telegram_chat_id = os.getenv("TELEGRAM_CHAT_ID")
    if telegram_chat_id:
        config["telegram"]["chat_id"] = telegram_chat_id

    return config


# كائن الإعدادات الجاهز للاستيراد في باقي الملفات
CONFIG = load_config()
